<robot name="scara_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="link_length"   value="0.3"/>
  <xacro:property name="link_width"    value="0.05"/>
  <xacro:property name="column_height" value="0.3"/>
  <xacro:property name="base_radius"   value="0.15"/>
  <xacro:property name="base_height"   value="0.05"/>
  <xacro:property name="ee_length"     value="0.3"/>

  <material name="black">  <color rgba="0 0 0 1"/>       </material>
  <material name="cyan">   <color rgba="0 1 1 1"/>       </material>
  <material name="green">  <color rgba="0 1 0 1"/>       </material>
  <material name="red">    <color rgba="1 0 0 1"/>       </material>

  <!-- Macros -->
  <xacro:macro name="box_link_macro" params="name size xyz rpy material">
    <link name="${name}">
      <visual>
        <geometry><box size="${size}"/></geometry>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <material name="${material}"/>
      </visual>
    </link>
  </xacro:macro>

  <xacro:macro name="cyl_link_macro" params="name radius length xyz rpy material">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <material name="${material}"/>
      </visual>
    </link>
  </xacro:macro>

  <xacro:macro name="rev_joint_macro" params="name parent child xyz rpy">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="10.0" velocity="10.0"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="pris_joint_macro" params="name parent child xyz rpy">
    <joint name="${name}" type="prismatic">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.15" upper="0.15" effort="10.0" velocity="1.0"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- Eslabones -->
  <xacro:cyl_link_macro name="base_link"
    radius="${base_radius}" length="${base_height}"
    xyz="0 0 0" rpy="0 0 0" material="black"/>

  <xacro:cyl_link_macro name="shoulder_link"
    radius="0.03" length="${column_height}"
    xyz="0 0 ${column_height/2}" rpy="0 0 0" material="red"/>

  <xacro:box_link_macro name="arm_link"
    size="${link_length} ${link_width} ${link_width}"
    xyz="${link_length/2} 0 0" rpy="0 0 0" material="red"/>

  <xacro:box_link_macro name="forearm_link"
    size="${link_length} ${link_width} ${link_width}"
    xyz="${link_length/2} 0 0" rpy="0 0 0" material="red"/>

  <!-- Efector final -->
  <link name="end_effector_link">
    <visual>
      <geometry><cylinder radius="0.015" length="${ee_length}"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="red"/>
    </visual>
  </link>

  <!-- Juntas -->
  <joint name="base_shoulder_joint" type="fixed">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

  <xacro:rev_joint_macro name="shoulder_joint"
    parent="shoulder_link" child="arm_link"
    xyz="0 0 ${column_height}" rpy="0 0 0"/>

  <xacro:rev_joint_macro name="arm_joint"
    parent="arm_link" child="forearm_link"
    xyz="${link_length} 0 0" rpy="0 0 0"/>

  <xacro:pris_joint_macro name="forearm_joint"
    parent="forearm_link" child="end_effector_link"
    xyz="${link_length} 0 0" rpy="0 0 0"/>

</robot>
