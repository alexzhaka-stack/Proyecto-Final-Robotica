<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--Descripción de los eslabones-->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.5 0.5 0.1"/>
      </geometry>
      <origin xyz="0 0 -0.05"/>
      <material name="black">
        <color rgba="0 0 0 0.5"/>
      </material>
    </visual>
  </link>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.3"/>
      </geometry>

      <!-- Shoulder parado verticalmente sobre la base -->
      <origin xyz="0 0 0.15" rpy="0 0 0"/>

      <material name="cyan">
        <color rgba="0 1 1 1"/>
      </material>
    </visual>
  </link>

  <link name="arm_link">
    <visual>
      <geometry>
        <box size="0.3 0.05 0.05"/>
      </geometry>
      <origin xyz="0.15 0 0"/>
      <material name="magenta">
        <color rgba="1 0 1 1"/>
      </material>
    </visual>
  </link>

  <link name="forearm_link">
    <visual>
      <geometry>
        <box size="0.3 0.05 0.05"/>
      </geometry>
      <origin xyz="0.15 0 0"/>
      <material name="yellow">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>
  </link>

  <!--Descripción de las juntas-->

  <!-- 1) Shoulder gira como torreta sobre Z -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="10.0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 2) Arm sube y baja, saliendo del plano XY -->
  <joint name="arm_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="arm_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="10.0"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
  </joint>

  <!-- Se conserva el nombre, pero se deja fijo para que solo haya 2 articulaciones móviles -->
  <joint name="forearm_joint" type="revolute">
    <parent link="arm_link"/>
    <child link="forearm_link"/>

    <!-- Eje para que el antebrazo suba/baje como codo -->
    <axis xyz="0 1 0"/>

    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="10.0"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
  </joint>
</robot>